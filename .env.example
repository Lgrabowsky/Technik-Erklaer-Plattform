# ───────── Pflicht ─────────
# Datenbank (PostgreSQL). Lokal z. B. mit "docker compose up -d" (siehe docker-compose.yml)
DATABASE_URL=postgres://plattform:plattform@localhost:5432/plattform
# Langer, zufälliger Geheimwert (mind. 32 Zeichen). Nie weitergeben!
PAYLOAD_SECRET=hier-einen-langen-zufaelligen-text-eintragen
# Adresse der Website (lokal: http://localhost:3000, später z. B. https://www.ihre-domain.de)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────── Bezahlen (Stripe) ─────────
# Stripe-Dashboard → Entwickler → API-Schlüssel. Zum Testen den "sk_test_…"-Schlüssel nehmen.
STRIPE_SECRET_KEY=
# Stripe-Dashboard → Entwickler → Webhooks (online) bzw. Ausgabe von "stripe listen" (lokal): whsec_…
STRIPE_WEBHOOK_SECRET=

# ───────── E-Mail-Versand (Anmelde-Links, Bestätigungen) ─────────
# Ohne diese Angaben werden E-Mails nur im Terminal angezeigt (zum lokalen Testen reicht das).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=hallo@ihre-domain.de
MAIL_FROM_NAME=Schritt für Schritt
# Hierhin gehen Hinweise zu neuen Kündigungen und Widerrufen
ADMIN_EMAIL=

# Nur auf dem Server: Datenbank per Migrationen aktualisieren (lokal weglassen)
# DATABASE_MIGRATIONS=true

# Optional: Ordner für hochgeladene Bilder (Standard: ./media)
# MEDIA_DIR=/var/lib/plattform/media
