# Kopieren nach /opt/technik-plattform/.env und ausfüllen.
# Diese Datei NIE ins Git-Repository legen. Rechte setzen: chmod 600 .env

# Domain ohne https:// und ohne www
DOMAIN=example.de
# Öffentliche Adresse der Seite (für Links in E-Mails und den Stripe-Rücksprung)
SITE_URL=https://example.de

# "caddy", wenn Caddy aus dieser Compose-Datei Port 80/443 übernehmen soll.
# Leer lassen, wenn schon ein anderer Reverse Proxy (nginx, Traefik ...) läuft.
COMPOSE_PROFILES=caddy

# Lokaler Port der App (nur ändern, wenn 3000 auf dem Server schon belegt ist)
APP_PORT=3000

# Datenbank. Passwort erzeugen mit: openssl rand -hex 24
POSTGRES_USER=technik
POSTGRES_PASSWORD=
POSTGRES_DB=technik

# Stripe (Dashboard > Entwickler > API-Schlüssel bzw. Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anmeldung / Sitzungen. Erzeugen mit: openssl rand -base64 32
AUTH_SECRET=

# E-Mail-Versand für Login-Links und Rechnungen (z. B. Brevo, Postmark, Mailjet)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Schritt für Schritt <hallo@example.de>"

# Optional: Sicherungen zusätzlich auf eine Hetzner Storage Box kopieren
# STORAGEBOX=u123456@u123456.your-storagebox.de
