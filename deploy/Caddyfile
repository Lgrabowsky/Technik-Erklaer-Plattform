# Caddy holt das HTTPS-Zertifikat (Let's Encrypt) automatisch und verlängert es.
# DOMAIN kommt aus der .env, z. B. schritt-fuer-schritt.de

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Admin-Bereich zusätzlich mit einem zweiten Passwort schützen (optional).
	# Hash erzeugen: docker compose exec caddy caddy hash-password
	# @admin path /admin*
	# basic_auth @admin {
	# 	admin <hash>
	# }

	reverse_proxy app:3000
}
