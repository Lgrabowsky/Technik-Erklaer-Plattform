# Nur nötig, wenn auf dem Server SCHON nginx auf Port 80/443 läuft.
# Datei nach /etc/nginx/sites-available/technik-plattform kopieren, Domain ersetzen,
# nach sites-enabled verlinken, dann:
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d example.de -d www.example.de

server {
    listen 80;
    server_name example.de www.example.de;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Next.js streamt Seiten, darum nicht puffern
        proxy_buffering off;
    }
}
